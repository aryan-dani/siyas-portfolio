# IndexNow Configuration
# Generate an 8-128 character alphanumeric key (e.g. from Bing Webmaster Tools or uuid)
INDEXNOW_KEY=
# Optional secret for the /api/indexnow webhook (defaults to INDEXNOW_KEY if unset)
INDEXNOW_SECRET=
# Canonical site URL (must match the host verified in IndexNow)
NEXT_PUBLIC_SITE_URL=https://www.heartsfromsiya.com
